# Create a bot with @BotFather. Never commit or send the actual token in a chat.
TELEGRAM_BOT_TOKEN=replace_with_a_new_token

# A public HTTPS address from Cloudflare Tunnel or ngrok, for example:
# WEBAPP_URL=https://silver-fox.trycloudflare.com
WEBAPP_URL=

# Optional: your Telegram numeric user ID, used for future administrative features.
TELEGRAM_ADMIN_ID=6899133760

# Optional legacy Crypto Pay token. Manual payment instructions use @morphosisss.
CRYPTO_PAY_TOKEN=

# Public URL of the bot API, for example https://bot-api.example.com
VITE_BOT_API_URL=
API_PORT=8787
SUBSCRIPTIONS_FILE=./data/subscriptions.json
WEBAPP_ORIGIN=
